# Salin ke .env.local untuk `bun run dev` dan skrip database. Jangan di-commit.

# Database untuk `bun run dev`; hanya alamat localhost yang diterima.
# Kosongkan untuk memakai PGlite (Postgres di dalam proses) di .data/pglite.
# Bisa juga Postgres lokal, mis. postgres://postgres:postgres@localhost:5432/natura
DATABASE_URL=

# Tujuan `make db-sync` / `make db-restore`. Kosong = server lokal proyek di port 5433.
# Sync menulis DATABASE_URL di .env.local agar bun run dev otomatis memakai salinan lokal.
LOCAL_DATABASE_URL=

# Opsional: direktori bin PostgreSQL jika belum ada di PATH.
# macOS Homebrew: /opt/homebrew/opt/postgresql@18/bin (Apple Silicon)
PG_BIN=

# Supabase untuk dump serta `bun run db:migrate:remote` dan `bun run seed:remote`:
# Supabase → Connect → "Session pooler" (port 5432). Hanya dipakai skrip, bukan oleh `bun run dev`.
REMOTE_DATABASE_URL=

# Opsional saat development; wajib di Vercel (acak, minimal 32 karakter: `openssl rand -base64 32`).
AUTH_SECRET=

# Alamat Info warga untuk QR/link yang dibagikan: https://clusternatura.com/info
# Kosong = alamat yang sedang dibuka (di Vercel: domain production).
APP_URL=
