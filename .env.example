# Salin ke .env.local lalu isi.

# Kosongkan untuk memakai database lokal (PGlite) di folder .data/ — cocok untuk mencoba.
# Production: connection string Postgres. Untuk Supabase: Connect → "Transaction pooler" (port 6543).
DATABASE_URL=

# Wajib di production: kunci acak minimal 32 karakter, mis. hasil `openssl rand -base64 32`.
AUTH_SECRET=

# Alamat publik aplikasi. Dipakai di QR yang dicetak, jadi isi sebelum mencetak stiker.
# Contoh: https://jimpitan-natura.vercel.app
APP_URL=

# Zona waktu untuk menentukan tanggal ronda. WIB: Asia/Jakarta, WITA: Asia/Makassar, WIT: Asia/Jayapura.
NEXT_PUBLIC_TIMEZONE=Asia/Jakarta
